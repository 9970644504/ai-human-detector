// ============================================
// AI PERSON PHOTO FINDER
// Electron Main Process
// ============================================

const {
    app,
    BrowserWindow,
    ipcMain,
    dialog
} = require("electron");

const path = require("path");
const fs = require("fs");


// ============================================
// GLOBAL WINDOW
// ============================================

let mainWindow;


// ============================================
// SUPPORTED IMAGE FORMATS
// ============================================

const SUPPORTED_IMAGE_EXTENSIONS = new Set([
    ".jpg",
    ".jpeg",
    ".png",
    ".webp",
    ".bmp",
    ".gif",
    ".tif",
    ".tiff"
]);


// ============================================
// CREATE MAIN WINDOW
// ============================================

function createWindow() {

    mainWindow = new BrowserWindow({

        width: 1400,
        height: 850,

        minWidth: 1000,
        minHeight: 650,

        backgroundColor: "#f5f7fb",

        webPreferences: {

            preload: path.join(
                __dirname,
                "preload.js"
            ),

            contextIsolation: true,
            nodeIntegration: false
        }

    });


    // Load application
    mainWindow.loadFile(
        path.join(
            __dirname,
            "src",
            "index.html"
        )
    );


    // Optional:
    // Open DevTools during development.
    // Remove/comment this later for final production.
    //
    // mainWindow.webContents.openDevTools();


    mainWindow.on("closed", () => {

        mainWindow = null;

    });
}


// ============================================
// APP READY
// ============================================

app.whenReady().then(() => {

    createWindow();


    // macOS:
    // Re-create window when dock icon is clicked.
    app.on("activate", () => {

        if (BrowserWindow.getAllWindows().length === 0) {
            createWindow();
        }

    });

});


// ============================================
// CLOSE APPLICATION
// ============================================

app.on("window-all-closed", () => {

    if (process.platform !== "darwin") {
        app.quit();
    }

});


// ============================================
// SELECT PHOTO FOLDER
// ============================================

ipcMain.handle(
    "select-folder",
    async () => {

        try {

            const result =
                await dialog.showOpenDialog(
                    mainWindow,
                    {
                        title: "Select Photo Collection",

                        properties: [
                            "openDirectory"
                        ]
                    }
                );


            // User cancelled
            if (
                result.canceled ||
                result.filePaths.length === 0
            ) {

                return null;

            }


            const selectedFolder =
                result.filePaths[0];


            console.log(
                "Selected folder:",
                selectedFolder
            );


            return selectedFolder;

        } catch (error) {

            console.error(
                "Folder selection error:",
                error
            );


            return null;

        }

    }
);


// ============================================
// COUNT IMAGES IN FOLDER
// ============================================

ipcMain.handle(
    "count-images",
    async (event, folderPath) => {

        try {

            // Validate folder path
            if (!folderPath) {

                return 0;

            }


            // Check whether path exists
            if (!fs.existsSync(folderPath)) {

                console.error(
                    "Folder does not exist:",
                    folderPath
                );

                return 0;

            }


            const stats =
                fs.statSync(folderPath);


            // Make sure it is a directory
            if (!stats.isDirectory()) {

                console.error(
                    "Selected path is not a folder:",
                    folderPath
                );

                return 0;

            }


            let imageCount = 0;


            // ----------------------------------------
            // Recursive directory scanner
            // ----------------------------------------

            function scanDirectory(directory) {

                let entries;


                try {

                    entries =
                        fs.readdirSync(
                            directory,
                            {
                                withFileTypes: true
                            }
                        );

                } catch (error) {

                    console.error(
                        "Unable to read directory:",
                        directory,
                        error.message
                    );

                    return;

                }


                for (const entry of entries) {

                    const fullPath =
                        path.join(
                            directory,
                            entry.name
                        );


                    // ------------------------------
                    // SUBDIRECTORY
                    // ------------------------------

                    if (entry.isDirectory()) {

                        scanDirectory(
                            fullPath
                        );

                        continue;

                    }


                    // ------------------------------
                    // FILE
                    // ------------------------------

                    if (!entry.isFile()) {

                        continue;

                    }


                    const extension =
                        path.extname(
                            entry.name
                        ).toLowerCase();


                    if (
                        SUPPORTED_IMAGE_EXTENSIONS
                            .has(extension)
                    ) {

                        imageCount++;

                    }

                }

            }


            // Start scanning
            scanDirectory(folderPath);


            console.log(
                `Images found: ${imageCount}`
            );


            return imageCount;

        } catch (error) {

            console.error(
                "Image counting failed:",
                error
            );


            return 0;

        }

    }
);


// ============================================
// GET IMAGE FILES
// ============================================
//
// We will use this later for the AI pipeline.
//
// It returns the actual image paths instead
// of loading the images into memory.
//

ipcMain.handle(
    "get-image-files",
    async (event, folderPath) => {

        try {

            if (!folderPath) {
                return [];
            }


            if (!fs.existsSync(folderPath)) {
                return [];
            }


            const imageFiles = [];


            function scanDirectory(directory) {

                let entries;


                try {

                    entries =
                        fs.readdirSync(
                            directory,
                            {
                                withFileTypes: true
                            }
                        );

                } catch (error) {

                    console.error(
                        "Unable to read:",
                        directory
                    );

                    return;

                }


                for (const entry of entries) {

                    const fullPath =
                        path.join(
                            directory,
                            entry.name
                        );


                    if (entry.isDirectory()) {

                        scanDirectory(
                            fullPath
                        );

                        continue;

                    }


                    if (!entry.isFile()) {

                        continue;

                    }


                    const extension =
                        path.extname(
                            entry.name
                        ).toLowerCase();


                    if (
                        SUPPORTED_IMAGE_EXTENSIONS
                            .has(extension)
                    ) {

                        imageFiles.push(
                            fullPath
                        );

                    }

                }

            }


            scanDirectory(folderPath);


            console.log(
                `Image files collected: ${imageFiles.length}`
            );


            return imageFiles;

        } catch (error) {

            console.error(
                "Getting image files failed:",
                error
            );


            return [];

        }

    }
);